        <mxCell id="OT9WE7ERhvFNiuSL_2hC-17" parent="OT9WE7ERhvFNiuSL_2hC-16" style="swimlane;whiteSpace=wrap;html=1;startSize=70;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;Clinical entities&lt;/font&gt;" vertex="1">
          <mxGeometry height="200" width="200" y="-10" as="geometry" />
        </mxCell>
        <mxCell id="OT9WE7ERhvFNiuSL_2hC-18" parent="OT9WE7ERhvFNiuSL_2hC-16" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=16;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;div style=&quot;color: rgb(0, 0, 0); text-align: start; font-family: &amp;quot;Segoe UI&amp;quot;; font-size: 14px; line-height: 20px;&quot;&gt;&lt;li&gt;MedicalRecord&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;&lt;/div&gt;&lt;/li&gt;&lt;li&gt;&lt;code&gt;ClinicalEntry&lt;/code&gt;&lt;/li&gt;&lt;li&gt;&lt;code&gt;Diagnosis&lt;/code&gt;&lt;/li&gt;&lt;li&gt;&lt;code&gt;Treatment&lt;/code&gt;&lt;/li&gt;&lt;li&gt;&lt;code&gt;Prescription&lt;/code&gt;&lt;/li&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="200" y="70" as="geometry" />
        </mxCell>
        <mxCell id="OT9WE7ERhvFNiuSL_2hC-19" parent="OT9WE7ERhvFNiuSL_2hC-21" style="swimlane;whiteSpace=wrap;html=1;startSize=70;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;div style=&quot;color: rgb(0, 0, 0); font-weight: 400; font-family: &amp;quot;Segoe UI&amp;quot;; line-height: 20px;&quot;&gt;&lt;h3 style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Doctor specialization entities&lt;/font&gt;&lt;/h3&gt;&lt;ol start=&quot;11&quot; style=&quot;font-size: 14px;&quot;&gt;&lt;/ol&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="200" x="520" as="geometry" />
        </mxCell>
        <mxCell id="OT9WE7ERhvFNiuSL_2hC-20" parent="OT9WE7ERhvFNiuSL_2hC-19" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=16;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;div style=&quot;color: rgb(0, 0, 0); text-align: start; font-family: &amp;quot;Segoe UI&amp;quot;; font-size: 14px; line-height: 20px;&quot;&gt;&lt;li&gt;&lt;code&gt;Specialization&lt;/code&gt;&lt;/li&gt;&lt;li&gt;&lt;code&gt;DoctorSpecialization&lt;/code&gt;&lt;/li&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="185.91" x="4.09" y="70" as="geometry" />
        </mxCell>
        <mxCell id="OT9WE7ERhvFNiuSL_2hC-22" parent="OT9WE7ERhvFNiuSL_2hC-23" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=16;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;div style=&quot;font-family: &amp;quot;Segoe UI&amp;quot;; font-style: normal; font-weight: 400; line-height: 20px;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;u&gt;✅ 1NF checkpoint&lt;/u&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;color: rgb(0, 0, 0); text-align: start; font-family: &amp;quot;Segoe UI&amp;quot;; font-size: 14px; line-height: 20px;&quot;&gt;&lt;p&gt;The important transformation has been:&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Before normalization: 6 entities&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;→ resolve repeated specializations and longitudinal clinical data&lt;/p&gt;&lt;p&gt;→ &lt;strong&gt;After 1NF: 12 entities&lt;/strong&gt;&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="160.07" width="726.19" as="geometry" />
        </mxCell>
        <mxCell id="OT9WE7ERhvFNiuSL_2hC-25" parent="OT9WE7ERhvFNiuSL_2hC-24" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=33;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="&lt;u&gt;&lt;font style=&quot;font-size: 39px;&quot; face=&quot;Times New Roman&quot;&gt;First_Normal_Form phase1.0&lt;/font&gt;&lt;/u&gt;" vertex="1">
          <mxGeometry height="50.34" width="732.94" x="470" y="10" as="geometry" />
        </mxCell>
        <mxCell id="OT9WE7ERhvFNiuSL_2hC-27" connectable="0" parent="1" style="group" value="" vertex="1">
          <mxGeometry height="410" width="636.55" x="2820" y="2150" as="geometry" />
        </mxCell>
        <mxCell id="MAwl2OnnpyVytO2v4TgS-356" parent="OT9WE7ERhvFNiuSL_2hC-27" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=33;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="&lt;u&gt;&lt;font style=&quot;font-size: 39px;&quot; face=&quot;Times New Roman&quot;&gt;Second_Normal_Form phase1.0&lt;/font&gt;&lt;/u&gt;" vertex="1">
          <mxGeometry height="42.599117647058826" width="520" x="30" as="geometry" />
        </mxCell>
        <mxCell id="OT9WE7ERhvFNiuSL_2hC-26" parent="OT9WE7ERhvFNiuSL_2hC-27" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;rounded=0;fontSize=16;" value="&lt;div style=&quot;color: rgb(0, 0, 0); text-align: start; font-family: &amp;quot;Segoe UI&amp;quot;; font-size: 14px; line-height: 20px;&quot;&gt;We are no longer looking for repeating values. We are looking for &lt;strong&gt;partial dependencies on composite primary keys&lt;/strong&gt;.&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0); text-align: start; font-family: &amp;quot;Segoe UI&amp;quot;; font-size: 14px; line-height: 20px;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0); text-align: start; font-family: &amp;quot;Segoe UI&amp;quot;; font-size: 14px; line-height: 20px;&quot;&gt;&lt;u&gt;2 NF requirements&lt;/u&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0); text-align: start; font-family: &amp;quot;Segoe UI&amp;quot;; font-size: 14px; line-height: 20px;&quot;&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;Every non-key attribute depends on the &lt;strong&gt;whole primary key&lt;/strong&gt;, not just part of a composite key.&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); background-color: transparent;&quot;&gt;- &lt;/span&gt;&lt;span style=&quot;color: rgb(0, 0, 0); background-color: transparent;&quot;&gt;There are &lt;/span&gt;&lt;strong style=&quot;color: rgb(0, 0, 0); background-color: transparent;&quot;&gt;no non-key attributes&lt;/strong&gt;&lt;span style=&quot;color: rgb(0, 0, 0); background-color: transparent;&quot;&gt;.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;- 10 /12 entities meet this requirement (No partial key dependency + 1NF passed)&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;- Introduce non-key attributes&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;- AppointmentDoctor (partial-key dependency in composite key): AppointmentID+DoctorID = PK&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;+&amp;nbsp;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); background-color: transparent;&quot;&gt;We don&#39;t need both IDs to know the appointment date (values for the non-key attribute)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); background-color: transparent;&quot;&gt;= 2NF passed.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); background-color: transparent;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;- SpecializationDoctor&amp;nbsp;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); background-color: transparent;&quot;&gt;(partial-key dependency in composite key):&amp;nbsp;&lt;/span&gt;SpecializationID&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); background-color: transparent;&quot;&gt;+DoctorID = PK&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 0); background-color: transparent;&quot;&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="376.15" width="501.6" x="40" y="33.85" as="geometry" />
        </mxCell>
        <mxCell id="VpzSjvloVnrgPybgbCj5-1" connectable="0" parent="1" style="group" value="" vertex="1">
          <mxGeometry height="480" width="833.77" x="3782.78" y="2220" as="geometry" />
        </mxCell>
        <mxCell id="VpzSjvloVnrgPybgbCj5-2" parent="VpzSjvloVnrgPybgbCj5-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=33;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="&lt;u&gt;&lt;font style=&quot;font-size: 39px;&quot; face=&quot;Times New Roman&quot;&gt;Third_Normal_Form phase1.0&lt;/font&gt;&lt;/u&gt;" vertex="1">
          <mxGeometry height="42.599117647058826" width="681.1097321498704" x="39.2947922394156" as="geometry" />
        </mxCell>
        <mxCell id="VpzSjvloVnrgPybgbCj5-3" parent="VpzSjvloVnrgPybgbCj5-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=16;" value="&lt;div style=&quot;color: rgb(0, 0, 0); font-family: &amp;quot;Segoe UI&amp;quot;; font-size: 14px; line-height: 20px;&quot;&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;APPOINTMENT&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;PK AppointmentID&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;FK PatientID&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;&amp;nbsp; &amp;nbsp;AppointmentDateTime&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;&amp;nbsp; &amp;nbsp;AppointmentStatus&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;&amp;nbsp; &amp;nbsp;ReasonForVisit&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;&lt;u&gt;+ Dependencies:&amp;nbsp;&lt;/u&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;AppointmentID → PatientID&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;AppointmentID → AppointmentDateTime&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;AppointmentID → AppointmentStatus&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;AppointmentID → ReasonForVisit&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;The interesting one is &lt;code&gt;PatientID&lt;/code&gt;.&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;&lt;p&gt;&lt;code&gt;AppointmentID → PatientID → PatientName&lt;/code&gt;&lt;/p&gt;&lt;p&gt;But &lt;strong&gt;PatientName isn&#39;t stored in Appointment, because patientdata can be fine in the patient entity&lt;/strong&gt;.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="427.4" width="350" x="440" y="52.6" as="geometry" />
        </mxCell>
        <mxCell id="VpzSjvloVnrgPybgbCj5-5" parent="VpzSjvloVnrgPybgbCj5-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;rounded=0;fontSize=16;" value="&lt;div style=&quot;color: rgb(0, 0, 0); text-align: start; font-family: &amp;quot;Segoe UI&amp;quot;; font-size: 14px; line-height: 20px;&quot;&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;Does a non-key attribute depend on &lt;strong&gt;another non-key attribute&lt;/strong&gt; rather than directly on the key?&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;&lt;p&gt;A useful shorthand is:&lt;/p&gt;&lt;p&gt;&lt;strong&gt;The key → the whole key → and nothing but the key.&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Example:&lt;/p&gt;&lt;p&gt;Does a&amp;nbsp;&lt;span style=&quot;color: rgb(0, 0, 0); background-color: transparent;&quot;&gt;Dependencies:&lt;/span&gt;&lt;/p&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;&lt;p&gt;&lt;code&gt;PatientID → FirstName, LastName, DateOfBirth, Phone, Email, Address&lt;/code&gt;&lt;/p&gt;&lt;p&gt;Nothing currently says something like:&lt;/p&gt;&lt;p&gt;&lt;code&gt;PatientID → PostalCode → City&lt;/code&gt;&lt;/p&gt;&lt;p&gt;So under our defined attributes:&lt;/p&gt;&lt;/div&gt;&lt;p&gt;&lt;strong style=&quot;color: rgb(0, 0, 0); background-color: transparent;&quot;&gt;✅ 3NF&lt;/strong&gt;?&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="410" width="366.6" x="73.4" y="52.6" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
