        <mxCell id="MAwl2OnnpyVytO2v4TgS-185" parent="MAwl2OnnpyVytO2v4TgS-169" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=none;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="" vertex="1">
          <mxGeometry height="30" width="101.26462704396306" y="180" as="geometry" />
        </mxCell>
        <mxCell id="MAwl2OnnpyVytO2v4TgS-186" parent="MAwl2OnnpyVytO2v4TgS-185" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;editable=0;overflow=hidden;whiteSpace=wrap;html=1;movable=0;resizable=0;rotatable=0;deletable=0;locked=1;" value="" vertex="1">
          <mxGeometry height="30" width="30" as="geometry">
            <mxRectangle height="30" width="30" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="MAwl2OnnpyVytO2v4TgS-187" parent="MAwl2OnnpyVytO2v4TgS-185" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=6;overflow=hidden;whiteSpace=wrap;html=1;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;" value="PaymentMethod" vertex="1">
          <mxGeometry height="30" width="71.26462704396306" x="30" as="geometry">
            <mxRectangle height="30" width="71.26462704396306" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="MAwl2OnnpyVytO2v4TgS-188" edge="1" parent="MAwl2OnnpyVytO2v4TgS-455" source="MAwl2OnnpyVytO2v4TgS-106" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;startSize=8;endSize=8;endArrow=none;endFill=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" target="MAwl2OnnpyVytO2v4TgS-173">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="MAwl2OnnpyVytO2v4TgS-189" parent="MAwl2OnnpyVytO2v4TgS-455" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=16;rotation=-90;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="1 : 0..1" vertex="1">
          <mxGeometry height="30.013824884792623" width="89.90225747406956" x="754.9484134374613" y="707.2257603686636" as="geometry" />
        </mxCell>
        <mxCell id="MAwl2OnnpyVytO2v4TgS-190" parent="MAwl2OnnpyVytO2v4TgS-455" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=16;rotation=90;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="1 : 1" vertex="1">
          <mxGeometry height="30.013824884792623" width="49.945698596705306" x="711.2059706064667" y="777.2580184331797" as="geometry" />
        </mxCell>
        <mxCell id="MAwl2OnnpyVytO2v4TgS-191" parent="MAwl2OnnpyVytO2v4TgS-455" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=16;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="1 : M" vertex="1">
          <mxGeometry height="30.013824884792623" width="64.49987516778523" x="948.5816270359971" y="862.2971889400922" as="geometry" />
        </mxCell>
        <mxCell id="MAwl2OnnpyVytO2v4TgS-193" parent="MAwl2OnnpyVytO2v4TgS-455" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=13;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;div style=&quot;color: rgb(0, 0, 0); text-align: start; font-family: &amp;quot;Segoe UI&amp;quot;; font-size: 11px; line-height: 20px;&quot;&gt;&lt;h3&gt;⚠️ A. &lt;code&gt;MedicalRecord&lt;/code&gt;&lt;/h3&gt;&lt;p&gt;Our assumption:&amp;nbsp;&lt;strong style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); background-color: transparent;&quot;&gt;Patient 1:1 Medical_Record&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;But a patient may accumulate &lt;strong&gt;multiple diagnoses, treatments and prescriptions over time&lt;/strong&gt;.&lt;/p&gt;&lt;p&gt;That could make the current &lt;code&gt;MedicalRecord&lt;/code&gt; structure problematic.&lt;/p&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="160.073732718894" width="293.90046882245275" x="34.732536561317545" y="190.085806451613" as="geometry" />
        </mxCell>
        <mxCell id="MAwl2OnnpyVytO2v4TgS-203" parent="MAwl2OnnpyVytO2v4TgS-455" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=10;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;div style=&quot;color: rgb(0, 0, 0); text-align: start; font-family: &amp;quot;Segoe UI&amp;quot;; font-size: 12px; line-height: 20px;&quot;&gt;&lt;h3&gt;⚠️ D. Appointment ↔ Doctor&lt;/h3&gt;&lt;p&gt;Our &lt;code&gt;AppointmentDoctor&lt;/code&gt; entity has a &lt;strong&gt;composite primary key&lt;/strong&gt;:&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;code&gt;(AppointmentID, DoctorID)&lt;/code&gt;&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;That means when we reach &lt;strong&gt;2NF&lt;/strong&gt;, this is the table where we need to be particularly careful about &lt;strong&gt;partial dependencies&lt;/strong&gt; if we add attributes such as &lt;code&gt;DoctorName&lt;/code&gt; or &lt;code&gt;AppointmentDate&lt;/code&gt;.&lt;/p&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="200.09216589861748" width="339.6307504575961" x="1204.5893598413659" y="870.3508986175115" as="geometry" />
        </mxCell>
        <mxCell id="MAwl2OnnpyVytO2v4TgS-194" parent="MAwl2OnnpyVytO2v4TgS-455" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=14;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;div style=&quot;color: rgb(0, 0, 0); font-family: &amp;quot;Segoe UI&amp;quot;; line-height: 100%;&quot;&gt;&lt;h3 style=&quot;line-height: 100%;&quot;&gt;&lt;u&gt;&lt;font style=&quot;font-size: 10px; line-height: 100%;&quot;&gt;⚠️ B. &lt;code&gt;Doctor.Specialization&lt;/code&gt;&lt;/font&gt;&lt;/u&gt;&lt;/h3&gt;&lt;p&gt;&lt;font style=&quot;font-size: 10px; line-height: 100%;&quot;&gt;A doctor might potentially have one or multiple specializations. The project material also refers to specialization within the broader healthcare model. &lt;a href=&quot;https://ibm-my.sharepoint.com/personal/romeo_ndlovu_ibm_com/Documents/Microsoft%20Copilot%20Chat%20Files/Enterprise%20Data%20Architecture%20and%20DataOps.pdf&quot; style=&quot;text-decoration: none; color: rgb(70, 79, 235);&quot;&gt;[Enterprise...ataOps.pdf | PDF]&lt;/a&gt;&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;font-size: 10px; line-height: 100%;&quot;&gt;We need to determine whether this is just a Doctor attribute or deserves its own entity.&lt;/font&gt;&lt;/p&gt;&lt;div style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;u&gt;&lt;font style=&quot;font-size: 10px; line-height: 100%;&quot;&gt;⚠️ Doctor&lt;/font&gt;&lt;/u&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;font style=&quot;font-size: 10px; line-height: 100%;&quot;&gt;If doctors can have multiple specializations, storing:&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;font style=&quot;font-size: 10px; line-height: 100%;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;Specialization = &quot;Cardiology, Internal Medicine&quot;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;font style=&quot;font-size: 10px; line-height: 100%;&quot;&gt;This fails for 1st Normalization Form, because specializations cannot be stored as one value.&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;font style=&quot;font-size: 10px; line-height: 100%;&quot;&gt;&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;Doctor Specialization Introduces:&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;white-space: pre-wrap; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;Many : Many relationshipOne doctor can have many specializations and one &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;specialization can be shared across doctors&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="217.30009216589858" width="422.7103589090909" x="1214.5096410909089" y="517.1382027649769" as="geometry" />
        </mxCell>
        <mxCell id="MAwl2OnnpyVytO2v4TgS-209" parent="MAwl2OnnpyVytO2v4TgS-455" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=10;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;p class=&quot;___1ehrlty f1s184ao fpgzoln&quot;&gt;&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;&lt;u&gt;&lt;font style=&quot;font-size: 18px;&quot; face=&quot;Garamond&quot;&gt; Example query&lt;/font&gt;&lt;/u&gt;&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;___1ehrlty f1s184ao fpgzoln&quot;&gt;&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;Later, if DigiHealth asks: &lt;/span&gt;&lt;span style=&quot;white-space: pre-wrap; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Show me every bill belonging to Patient P001.&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;___1ehrlty f1s184ao fpgzoln&quot;&gt;&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;We don&#39;t need &lt;/span&gt;&lt;code spellcheck=&quot;false&quot; style=&quot;white-space: pre-wrap;&quot;&gt;PatientID&lt;/code&gt;&lt;span style=&quot;white-space: pre-wrap;&quot;&gt; inside Billing.&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;___1ehrlty f1s184ao fpgzoln&quot;&gt;&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;We can join the tables:&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;___1ehrlty f1s184ao fpgzoln&quot;&gt;&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;&lt;font face=&quot;Garamond&quot;&gt;SQL&lt;/font&gt;&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;___1ehrlty f1s184ao fpgzoln&quot;&gt;&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;SELECT b.* &lt;/span&gt;&lt;span style=&quot;white-space: pre-wrap; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;FROM Billing b&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;___1ehrlty f1s184ao fpgzoln&quot;&gt;&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;JOIN Appointment a &lt;/span&gt;&lt;span style=&quot;white-space: pre-wrap; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;ON b.AppointmentID = a.AppointmentID&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;___1ehrlty f1s184ao fpgzoln&quot;&gt;&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;WHERE a.PatientID = &#39;P001&#39;;&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;___1ehrlty f1s184ao fpgzoln&quot;&gt;&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;The database follows:&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;___1ehrlty f1s184ao fpgzoln&quot;&gt;&lt;b&gt;&lt;strong class=&quot;___1qwroh2 fl43uef f19n0e5&quot; style=&quot;white-space: pre-wrap;&quot;&gt;Billing → Appointment → Patient&lt;/strong&gt;&lt;/b&gt;&lt;/p&gt;&lt;p class=&quot;___1ehrlty f1s184ao fpgzoln&quot;&gt;&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;So no business capability is lost by removing &lt;/span&gt;&lt;code spellcheck=&quot;false&quot; style=&quot;white-space: pre-wrap;&quot;&gt;PatientID&lt;/code&gt;&lt;span style=&quot;white-space: pre-wrap;&quot;&gt; from Billing.&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="180.08294930875573" width="396.9018181818182" x="1214.5096410909089" y="250.11520737327186" as="geometry" />
        </mxCell>
        <mxCell id="MAwl2OnnpyVytO2v4TgS-206" edge="1" parent="MAwl2OnnpyVytO2v4TgS-455" source="MAwl2OnnpyVytO2v4TgS-102" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;startSize=8;endSize=8;endArrow=none;endFill=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" target="MAwl2OnnpyVytO2v4TgS-144">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="MAwl2OnnpyVytO2v4TgS-210" parent="MAwl2OnnpyVytO2v4TgS-455" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=16;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;div style=&quot;color: rgb(0, 0, 0); text-align: start; font-family: &amp;quot;Segoe UI&amp;quot;; font-size: 14px; line-height: 20px;&quot;&gt;Appointment created → Scheduled → Completed → Bill generated&amp;nbsp; (1 : 0..1)&lt;/div&gt;" vertex="1">
          <mxGeometry height="60.027649769585246" width="411.7856363636364" x="775.0897156363635" y="450.20737327188937" as="geometry" />
        </mxCell>
        <mxCell id="MAwl2OnnpyVytO2v4TgS-211" parent="MAwl2OnnpyVytO2v4TgS-455" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=16;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;div style=&quot;color: rgb(0, 0, 0); text-align: start; font-family: &amp;quot;Segoe UI&amp;quot;; font-size: 14px; line-height: 130%;&quot;&gt;&lt;p&gt;If we say:&amp;nbsp;&lt;strong style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); background-color: transparent;&quot;&gt;Patient &lt;code&gt;1:1&lt;/code&gt; MedicalRecord&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;we&#39;re saying every Patient &lt;strong&gt;must have exactly one&lt;/strong&gt; MedicalRecord.&lt;/p&gt;&lt;p&gt;But consider a patient who has just registered and hasn&#39;t yet received medical care.&lt;/p&gt;&lt;p&gt;If DigiHealth allows that situation, a more accurate business rule may actually be:&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Patient &lt;code&gt;1 ───── 0..1&lt;/code&gt; MedicalRecord&lt;/strong&gt;&lt;/p&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110.05069124423962" width="268.73229854545457" x="34.73673199999979" y="430.1958387096775" as="geometry" />
        </mxCell>
        <mxCell id="MAwl2OnnpyVytO2v4TgS-212" parent="MAwl2OnnpyVytO2v4TgS-455" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=12;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;div&gt;&lt;span&gt;MedicalRecordID: MR001&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;Diagnosis: Hypertension, Influenza&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;Treatment: Medication A, Medication B&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;Prescription: Drug A, Drug B, Drug C&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;color: rgb(0, 0, 0); font-family: &amp;quot;Segoe UI&amp;quot;; font-size: 14px; line-height: 20px;&quot;&gt;That is exactly where &lt;strong&gt;1NF&lt;/strong&gt; starts becoming relevant....&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0); font-family: &amp;quot;Segoe UI&amp;quot;; font-size: 14px; line-height: 20px;&quot;&gt;We need to isolate prescription, treatment and diagnosis&lt;/div&gt;&lt;div style=&quot;font-family: &amp;quot;Segoe UI&amp;quot;; line-height: 20px;&quot;&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="180.08294930875573" width="238.0319429090909" x="311.55800472727253" y="202.9950230414746" as="geometry" />
        </mxCell>
        <mxCell id="MAwl2OnnpyVytO2v4TgS-359" edge="1" parent="MAwl2OnnpyVytO2v4TgS-455" source="MAwl2OnnpyVytO2v4TgS-222" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;fontSize=12;startSize=8;endSize=8;entryX=0.5;entryY=0;entryDx=0;entryDy=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" target="MAwl2OnnpyVytO2v4TgS-360">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="470.3187319999998" y="891.6607142857142" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="MAwl2OnnpyVytO2v4TgS-222" parent="MAwl2OnnpyVytO2v4TgS-455" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=16;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;div style=&quot;color: rgb(0, 0, 0); text-align: start; font-family: &amp;quot;Segoe UI&amp;quot;; font-size: 14px; line-height: 20px;&quot;&gt;&lt;p&gt;The central rule of &lt;strong&gt;First Normal Form&lt;/strong&gt; is:&lt;/p&gt;&lt;blockquote&gt;&lt;p&gt;Each attribute should contain a single, atomic value. We should not store repeating groups or lists of values in one column.&lt;/p&gt;&lt;/blockquote&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="191.9884331797235" width="227.39497418181818" x="311.55800472727253" y="383.0787557603686" as="geometry" />
        </mxCell>
        <mxCell id="MAwl2OnnpyVytO2v4TgS-361" connectable="0" parent="MAwl2OnnpyVytO2v4TgS-455" style="group;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="" vertex="1">
          <mxGeometry height="60.027649769585246" width="519.9314592727274" x="32.218909090909094" y="623.0015207373272" as="geometry" />
        </mxCell>
        <mxCell id="MAwl2OnnpyVytO2v4TgS-360" parent="MAwl2OnnpyVytO2v4TgS-361" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="" vertex="1">
          <mxGeometry height="60.027649769585246" width="519.9314592727274" as="geometry" />
        </mxCell>
        <mxCell id="MAwl2OnnpyVytO2v4TgS-217" edge="1" parent="MAwl2OnnpyVytO2v4TgS-361" source="MAwl2OnnpyVytO2v4TgS-214" style="edgeStyle=none;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;startSize=8;endSize=8;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" target="MAwl2OnnpyVytO2v4TgS-215">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="MAwl2OnnpyVytO2v4TgS-214" parent="MAwl2OnnpyVytO2v4TgS-361" style="rounded=1;whiteSpace=wrap;html=1;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="Patient" vertex="1">
