        <mxCell id="OT9WE7ERhvFNiuSL_2hC-19" parent="OT9WE7ERhvFNiuSL_2hC-21" style="swimlane;whiteSpace=wrap;html=1;startSize=70;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;div style=&quot;color: rgb(0, 0, 0); font-weight: 400; font-family: &amp;quot;Segoe UI&amp;quot;; line-height: 20px;&quot;&gt;&lt;h3 style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Doctor specialization entities&lt;/font&gt;&lt;/h3&gt;&lt;ol start=&quot;11&quot; style=&quot;font-size: 14px;&quot;&gt;&lt;/ol&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="200" x="520" as="geometry" />
        </mxCell>
        <mxCell id="OT9WE7ERhvFNiuSL_2hC-20" parent="OT9WE7ERhvFNiuSL_2hC-19" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=16;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;div style=&quot;color: rgb(0, 0, 0); text-align: start; font-family: &amp;quot;Segoe UI&amp;quot;; font-size: 14px; line-height: 20px;&quot;&gt;&lt;li&gt;&lt;code&gt;Specialization&lt;/code&gt;&lt;/li&gt;&lt;li&gt;&lt;code&gt;DoctorSpecialization&lt;/code&gt;&lt;/li&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="185.91" x="4.09" y="70" as="geometry" />
        </mxCell>
        <mxCell id="OT9WE7ERhvFNiuSL_2hC-22" parent="OT9WE7ERhvFNiuSL_2hC-23" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=16;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;div style=&quot;font-family: &amp;quot;Segoe UI&amp;quot;; font-style: normal; font-weight: 400; line-height: 20px;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;u&gt;✅ 1NF checkpoint&lt;/u&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;color: rgb(0, 0, 0); text-align: start; font-family: &amp;quot;Segoe UI&amp;quot;; font-size: 14px; line-height: 20px;&quot;&gt;&lt;p&gt;The important transformation has been:&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Before normalization: 6 entities&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;→ resolve repeated specializations and longitudinal clinical data&lt;/p&gt;&lt;p&gt;→ &lt;strong&gt;After 1NF: 12 entities&lt;/strong&gt;&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="160.07" width="726.19" as="geometry" />
        </mxCell>
        <mxCell id="VpzSjvloVnrgPybgbCj5-876" connectable="0" parent="1" style="group;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="" vertex="1">
          <mxGeometry height="1383.66" width="2817.67" x="-9.060000000000002" y="2002.57" as="geometry" />
        </mxCell>
        <mxCell id="VpzSjvloVnrgPybgbCj5-874" connectable="0" parent="VpzSjvloVnrgPybgbCj5-876" style="group" value="" vertex="1">
          <mxGeometry height="1186.23" width="2817.67" y="197.43000000000006" as="geometry" />
        </mxCell>
        <mxCell id="OT9WE7ERhvFNiuSL_2hC-27" connectable="0" parent="VpzSjvloVnrgPybgbCj5-874" style="group;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="" vertex="1">
          <mxGeometry height="521.85" width="772.56" y="4.380000000000109" as="geometry" />
        </mxCell>
        <mxCell id="MAwl2OnnpyVytO2v4TgS-356" parent="OT9WE7ERhvFNiuSL_2hC-27" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=33;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="&lt;u&gt;&lt;font style=&quot;font-size: 39px;&quot; face=&quot;Times New Roman&quot;&gt;Second_Normal_Form phase1.0&lt;/font&gt;&lt;/u&gt;" vertex="1">
          <mxGeometry height="54.220364741750366" width="631.1070615034168" x="36.41002277904328" as="geometry" />
        </mxCell>
        <mxCell id="OT9WE7ERhvFNiuSL_2hC-26" parent="OT9WE7ERhvFNiuSL_2hC-27" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;rounded=0;fontSize=16;" value="&lt;div style=&quot;color: rgb(0, 0, 0); text-align: start; font-family: &amp;quot;Segoe UI&amp;quot;; font-size: 14px; line-height: 20px;&quot;&gt;We are no longer looking for repeating values. We are looking for &lt;strong&gt;partial dependencies on composite primary keys&lt;/strong&gt;.&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0); text-align: start; font-family: &amp;quot;Segoe UI&amp;quot;; font-size: 14px; line-height: 20px;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0); text-align: start; font-family: &amp;quot;Segoe UI&amp;quot;; font-size: 14px; line-height: 20px;&quot;&gt;&lt;u&gt;2 NF requirements&lt;/u&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0); text-align: start; font-family: &amp;quot;Segoe UI&amp;quot;; font-size: 14px; line-height: 20px;&quot;&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;Every non-key attribute depends on the &lt;strong&gt;whole primary key&lt;/strong&gt;, not just part of a composite key.&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); background-color: transparent;&quot;&gt;- &lt;/span&gt;&lt;span style=&quot;color: rgb(0, 0, 0); background-color: transparent;&quot;&gt;There are &lt;/span&gt;&lt;strong style=&quot;color: rgb(0, 0, 0); background-color: transparent;&quot;&gt;no non-key attributes&lt;/strong&gt;&lt;span style=&quot;color: rgb(0, 0, 0); background-color: transparent;&quot;&gt;.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;- 10 /12 entities meet this requirement (No partial key dependency + 1NF passed)&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;- Introduce non-key attributes&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;- AppointmentDoctor (partial-key dependency in composite key): AppointmentID+DoctorID = PK&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;+&amp;nbsp;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); background-color: transparent;&quot;&gt;We don&#39;t need both IDs to know the appointment date (values for the non-key attribute)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); background-color: transparent;&quot;&gt;= 2NF passed.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); background-color: transparent;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;- SpecializationDoctor&amp;nbsp;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); background-color: transparent;&quot;&gt;(partial-key dependency in composite key):&amp;nbsp;&lt;/span&gt;SpecializationID&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); background-color: transparent;&quot;&gt;+DoctorID = PK&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 0); background-color: transparent;&quot;&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="478.7655548780488" width="608.7755808656036" x="48.546697038724375" y="43.08444512195123" as="geometry" />
        </mxCell>
        <mxCell id="VpzSjvloVnrgPybgbCj5-1" connectable="0" parent="VpzSjvloVnrgPybgbCj5-874" style="group;verticalAlign=top;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="" vertex="1">
          <mxGeometry height="1181.85" width="1013.61" x="676.4500000000003" y="4.380000000000109" as="geometry" />
        </mxCell>
        <mxCell id="VpzSjvloVnrgPybgbCj5-2" parent="VpzSjvloVnrgPybgbCj5-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=33;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="&lt;u&gt;&lt;font style=&quot;font-size: 39px;&quot; face=&quot;Times New Roman&quot;&gt;Third_Normal_Form phase 2.0&lt;/font&gt;&lt;/u&gt;" vertex="1">
          <mxGeometry height="71.88601102941178" width="828.0216793653287" x="47.770481501845886" as="geometry" />
        </mxCell>
        <mxCell id="VpzSjvloVnrgPybgbCj5-39" connectable="0" parent="VpzSjvloVnrgPybgbCj5-1" style="group" value="" vertex="1">
          <mxGeometry height="521.8564615384611" width="871.1728669883661" x="89.22751128735577" y="50.003538461538476" as="geometry" />
        </mxCell>
        <mxCell id="VpzSjvloVnrgPybgbCj5-3" parent="VpzSjvloVnrgPybgbCj5-39" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=16;" value="&lt;div style=&quot;color: rgb(0, 0, 0); font-family: &amp;quot;Segoe UI&amp;quot;; font-size: 14px; line-height: 20px;&quot;&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;APPOINTMENT&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;PK AppointmentID&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;FK PatientID&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;&amp;nbsp; &amp;nbsp;AppointmentDateTime&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;&amp;nbsp; &amp;nbsp;AppointmentStatus&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;&amp;nbsp; &amp;nbsp;ReasonForVisit&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;&lt;u&gt;+ Dependencies:&amp;nbsp;&lt;/u&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 120%;&quot;&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;AppointmentID → PatientID&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;AppointmentID → AppointmentDateTime&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;AppointmentID → AppointmentStatus&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;AppointmentID → ReasonForVisit&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;The interesting one is PatientID.&lt;/div&gt;&lt;p&gt;&lt;code&gt;AppointmentID → PatientID → PatientName&lt;/code&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); background-color: transparent;&quot;&gt;.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); background-color: transparent;&quot;&gt;But &lt;/span&gt;&lt;strong style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); background-color: transparent;&quot;&gt;PatientName isn&#39;t stored in Appointment, because patient data can be found in the patient entity&lt;/strong&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); background-color: transparent;&quot;&gt;.&lt;/span&gt;&lt;/p&gt;&lt;div style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;div style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;div style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;div style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;p&gt;&lt;strong&gt;Billing → Appointment → Patient&lt;/strong&gt;&lt;/p&gt;&lt;h3 style=&quot;line-height: 120%;&quot;&gt;✅ Billing passes our 3NF audit.&lt;/h3&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="521.8518461538462" width="425.495370989704" x="445.6774959986622" as="geometry" />
        </mxCell>
        <mxCell id="VpzSjvloVnrgPybgbCj5-5" parent="VpzSjvloVnrgPybgbCj5-39" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;rounded=0;fontSize=16;" value="&lt;div style=&quot;color: rgb(0, 0, 0); text-align: start; font-family: &amp;quot;Segoe UI&amp;quot;; font-size: 14px; line-height: 20px;&quot;&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;Does a non-key attribute depend on &lt;strong&gt;another non-key attribute&lt;/strong&gt; rather than directly on the key?&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;&lt;p&gt;A useful shorthand is:&lt;/p&gt;&lt;p&gt;&lt;strong&gt;The key → the whole key → and nothing but the key.&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Example:&lt;/p&gt;&lt;p&gt;Does a&amp;nbsp;&lt;span style=&quot;color: rgb(0, 0, 0); background-color: transparent;&quot;&gt;Dependencies:&lt;/span&gt;&lt;/p&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;&lt;p&gt;&lt;code&gt;PatientID → FirstName, LastName, DateOfBirth, Phone, Email, Address&lt;/code&gt;&lt;/p&gt;&lt;p&gt;Nothing currently says something like:&lt;/p&gt;&lt;p&gt;&lt;code&gt;PatientID → PostalCode → City&lt;/code&gt;&lt;/p&gt;&lt;p&gt;So under our defined attributes:&lt;/p&gt;&lt;/div&gt;&lt;p&gt;&lt;strong style=&quot;color: rgb(0, 0, 0); background-color: transparent;&quot;&gt;✅ 3NF&lt;/strong&gt;?&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="521.8518461538462" width="445.6774959986622" as="geometry" />
        </mxCell>
        <mxCell id="VpzSjvloVnrgPybgbCj5-40" parent="VpzSjvloVnrgPybgbCj5-39" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=16;" value="&lt;div style=&quot;color: rgb(0, 0, 0); text-align: start; font-family: &amp;quot;Segoe UI&amp;quot;; font-size: 14px; line-height: 20px;&quot;&gt;&lt;u&gt;Task 1 Audit:&lt;br&gt;&lt;/u&gt;Without an &lt;code&gt;AppointmentID&lt;/code&gt; relationship on the clinical event, we&#39;d know &lt;strong&gt;which patient record contains CE901&lt;/strong&gt;, but wouldn&#39;t directly know &lt;strong&gt;which appointment generated it&lt;/strong&gt;.&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 0); text-align: start; font-family: &amp;quot;Segoe UI&amp;quot;; font-size: 14px; line-height: 20px;&quot;&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;&lt;p&gt;This isn&#39;t primarily a 3NF failure. It&#39;s a &lt;strong&gt;business traceability question&lt;/strong&gt; in the logical model.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110.34" width="695.83" x="0.0024887126442081353" y="411.51646153846104" as="geometry" />
        </mxCell>
        <mxCell id="VpzSjvloVnrgPybgbCj5-53" connectable="0" parent="VpzSjvloVnrgPybgbCj5-1" style="group" value="" vertex="1">
          <mxGeometry height="30" width="665.87694990564" x="72.641121807888" y="575.92" as="geometry" />
        </mxCell>
