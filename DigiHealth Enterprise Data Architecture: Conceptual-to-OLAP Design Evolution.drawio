        <mxCell id="VpzSjvloVnrgPybgbCj5-875" parent="VpzSjvloVnrgPybgbCj5-876" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=16;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 100px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Logical Model V3.0 Normalization Forms&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="275" width="2245" x="174.06" as="geometry" />
        </mxCell>
        <mxCell id="VpzSjvloVnrgPybgbCj5-877" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=54;fontFamily=Helvetica;fontColor=default;fontStyle=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;font style=&quot;font-size: 73px;&quot;&gt;MySQL OLTP Physical Data modeling v1.0&lt;/font&gt;" vertex="1">
          <mxGeometry height="114.94" width="1432.94" x="3343.61" y="2168.34" as="geometry" />
        </mxCell>
        <mxCell id="VpzSjvloVnrgPybgbCj5-878" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=16;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;div&gt;&lt;span&gt;-- ============================================================&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;-- DigiHealth OLTP Database&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;-- Normalized to Third Normal Form (3NF)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;-- ============================================================&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;-- ------------------------------------------------------------&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;-- 1. CREATE DATABASE&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;-- ------------------------------------------------------------&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;CREATE DATABASE IF NOT EXISTS DigiHealth_DB;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;USE DigiHealth_DB;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;-- ============================================================&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;-- 2. PATIENT&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;-- ============================================================&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;CREATE TABLE Patient (&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; PatientID INT AUTO_INCREMENT PRIMARY KEY,&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; FirstName VARCHAR(100) NOT NULL,&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; LastName VARCHAR(100) NOT NULL,&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; DateOfBirth DATE NOT NULL,&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; Phone VARCHAR(20),&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; Email VARCHAR(255),&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; Address VARCHAR(255)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;);&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;-- ============================================================&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;-- 3. DOCTOR&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;-- ============================================================&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;CREATE TABLE Doctor (&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; DoctorID INT AUTO_INCREMENT PRIMARY KEY,&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; FirstName VARCHAR(100) NOT NULL,&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; LastName VARCHAR(100) NOT NULL,&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; Phone VARCHAR(20),&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; Email VARCHAR(255)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;);&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;-- ============================================================&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;-- 4. SPECIALIZATION&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;-- ============================================================&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;CREATE TABLE Specialization (&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; SpecializationID INT AUTO_INCREMENT PRIMARY KEY,&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; SpecializationName VARCHAR(100) NOT NULL UNIQUE&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;);&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="800" width="655" x="2999" y="2294.4" as="geometry" />
        </mxCell>
        <mxCell id="VpzSjvloVnrgPybgbCj5-879" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=16;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;div&gt;-- ============================================================&lt;/div&gt;&lt;div&gt;-- 5. APPOINTMENT&lt;/div&gt;&lt;div&gt;-- ============================================================&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;&lt;span&gt;CREATE TABLE Appointment (&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; AppointmentID INT AUTO_INCREMENT PRIMARY KEY,&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; PatientID INT NOT NULL,&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; AppointmentDateTime DATETIME NOT NULL,&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; AppointmentStatus VARCHAR(30) NOT NULL,&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; ReasonForVisit VARCHAR(255),&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; CONSTRAINT fk_appointment_patient&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; FOREIGN KEY (PatientID)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; REFERENCES Patient(PatientID),&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; CONSTRAINT chk_appointment_status&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; CHECK (&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; AppointmentStatus IN (&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &#39;Scheduled&#39;,&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &#39;Completed&#39;,&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &#39;Cancelled&#39;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; )&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; )&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;);&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;-- ============================================================&lt;/div&gt;&lt;div&gt;-- 6. MEDICAL RECORD&lt;/div&gt;&lt;div&gt;-- Patient 1 : 0..1 MedicalRecord&lt;/div&gt;&lt;div&gt;-- UNIQUE PatientID ensures one record per patient&lt;/div&gt;&lt;div&gt;-- ============================================================&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;CREATE TABLE MedicalRecord (&lt;/div&gt;&lt;div&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; MedicalRecordID INT AUTO_INCREMENT PRIMARY KEY,&lt;/div&gt;&lt;div&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; PatientID INT NOT NULL UNIQUE,&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; CONSTRAINT fk_medicalrecord_patient&lt;/div&gt;&lt;div&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; FOREIGN KEY (PatientID)&lt;/div&gt;&lt;div&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; REFERENCES Patient(PatientID)&lt;/div&gt;&lt;div&gt;);&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;-- ============================================================&lt;/div&gt;&lt;div&gt;-- 7. APPOINTMENT DOCTOR&lt;/div&gt;&lt;div&gt;-- Resolves Appointment M:M Doctor relationship&lt;/div&gt;&lt;div&gt;-- ============================================================&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;CREATE TABLE AppointmentDoctor (&lt;/div&gt;&lt;div&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; AppointmentID INT NOT NULL,&lt;/div&gt;&lt;div&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; DoctorID INT NOT NULL,&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; PRIMARY KEY (AppointmentID, DoctorID),&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; CONSTRAINT fk_appointmentdoctor_appointment&lt;/div&gt;&lt;div&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; FOREIGN KEY (AppointmentID)&lt;/div&gt;&lt;div&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; REFERENCES Appointment(AppointmentID),&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; CONSTRAINT fk_appointmentdoctor_doctor&lt;/div&gt;&lt;div&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; FOREIGN KEY (DoctorID)&lt;/div&gt;&lt;div&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; REFERENCES Doctor(DoctorID)&lt;/div&gt;&lt;div&gt;);&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;-- ============================================================&lt;/div&gt;&lt;div&gt;-- 8. DOCTOR SPECIALIZATION&lt;/div&gt;&lt;div&gt;-- Resolves Doctor M:M Specialization relationship&lt;/div&gt;&lt;div&gt;-- ============================================================&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;CREATE TABLE DoctorSpecialization (&lt;/div&gt;&lt;div&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; DoctorID INT NOT NULL,&lt;/div&gt;&lt;div&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; SpecializationID INT NOT NULL,&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; PRIMARY KEY (DoctorID, SpecializationID),&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; CONSTRAINT fk_doctorspecialization_doctor&lt;/div&gt;&lt;div&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; FOREIGN KEY (DoctorID)&lt;/div&gt;&lt;div&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; REFERENCES Doctor(DoctorID),&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; CONSTRAINT fk_doctorspecialization_specialization&lt;/div&gt;&lt;div&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; FOREIGN KEY (SpecializationID)&lt;/div&gt;&lt;div&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; REFERENCES Specialization(SpecializationID)&lt;/div&gt;&lt;div&gt;);&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="1181.85" width="675" x="3600" y="2324.96" as="geometry" />
        </mxCell>
        <mxCell id="VpzSjvloVnrgPybgbCj5-880" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=16;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;div&gt;&lt;div&gt;-- ============================================================&lt;/div&gt;&lt;div&gt;-- 9. CLINICAL ENTRY&lt;/div&gt;&lt;div&gt;-- Clinical entries are associated with appointments&lt;/div&gt;&lt;div&gt;--&lt;/div&gt;&lt;div&gt;-- Patient and MedicalRecord are derived through:&lt;/div&gt;&lt;div&gt;-- ClinicalEntry -&amp;gt; Appointment -&amp;gt; Patient -&amp;gt; MedicalRecord&lt;/div&gt;&lt;div&gt;-- ============================================================&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;CREATE TABLE ClinicalEntry (&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; ClinicalEntryID INT AUTO_INCREMENT PRIMARY KEY,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; AppointmentID INT NOT NULL,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; EntryDateTime DATETIME NOT NULL,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; Notes TEXT,&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; CONSTRAINT fk_clinicalentry_appointment&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; FOREIGN KEY (AppointmentID)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; REFERENCES Appointment(AppointmentID)&lt;/div&gt;&lt;div&gt;);&lt;/div&gt;&lt;div&gt;-- ============================================================&lt;/div&gt;&lt;div&gt;-- 10. DIAGNOSIS&lt;/div&gt;&lt;div&gt;-- One ClinicalEntry can contain multiple diagnoses&lt;/div&gt;&lt;div&gt;-- ============================================================&lt;/div&gt;&lt;div&gt;CREATE TABLE Diagnosis (&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; DiagnosisID INT AUTO_INCREMENT PRIMARY KEY,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; ClinicalEntryID INT NOT NULL,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; DiagnosisDescription VARCHAR(255) NOT NULL,&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; CONSTRAINT fk_diagnosis_clinicalentry&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; FOREIGN KEY (ClinicalEntryID)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; REFERENCES ClinicalEntry(ClinicalEntryID)&lt;/div&gt;&lt;div&gt;);&lt;/div&gt;&lt;div&gt;-- ============================================================&lt;/div&gt;&lt;div&gt;-- 11. TREATMENT&lt;/div&gt;&lt;div&gt;-- One ClinicalEntry can contain multiple treatments&lt;/div&gt;&lt;div&gt;-- ============================================================&lt;/div&gt;&lt;div&gt;CREATE TABLE Treatment (&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; TreatmentID INT AUTO_INCREMENT PRIMARY KEY,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; ClinicalEntryID INT NOT NULL,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; TreatmentDescription VARCHAR(255) NOT NULL,&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; CONSTRAINT fk_treatment_clinicalentry&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; FOREIGN KEY (ClinicalEntryID)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; REFERENCES ClinicalEntry(ClinicalEntryID)&lt;/div&gt;&lt;div&gt;);&lt;/div&gt;&lt;div&gt;-- ============================================================&lt;/div&gt;&lt;div&gt;-- 12. PRESCRIPTION&lt;/div&gt;&lt;div&gt;-- One ClinicalEntry can contain multiple prescriptions&lt;/div&gt;&lt;div&gt;-- ============================================================&lt;/div&gt;&lt;div&gt;CREATE TABLE Prescription (&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; PrescriptionID INT AUTO_NCREMENT PRIMARY KEY,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; ClinicalEntryID INT NOT NULL,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; MedicationName VARCHAR(150) NOT NULL,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; Dosage VARCHAR(100),&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; Frequency VARCHAR(100),&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; CONSTRAINT fk_prescription_clinicalentry&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; FOREIGN KEY (ClinicalEntryID)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; REFERENCES ClinicalEntry(ClinicalEntryID)&lt;/div&gt;&lt;div&gt;);&lt;/div&gt;&lt;div&gt;-- ============================================================&lt;/div&gt;&lt;div&gt;-- 13. BILLING&lt;/div&gt;&lt;div&gt;-- Appointment 1 : 0..1 Billing&lt;/div&gt;&lt;div&gt;--&lt;/div&gt;&lt;div&gt;-- UNIQUE AppointmentID prevents multiple billing records&lt;/div&gt;&lt;div&gt;-- for the same appointment.&lt;/div&gt;&lt;div&gt;-- PatientID is intentionally NOT stored because:&lt;/div&gt;&lt;div&gt;-- Billing -&amp;gt; Appointment -&amp;gt; Patient&lt;/div&gt;&lt;div&gt;-- ============================================================&lt;/div&gt;&lt;div&gt;CREATE TABLE Billing (&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; BillingID INT AUTO_INCREMENT PRIMARY KEY,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; AppointmentID INT NOT NULL UNIQUE,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; BillingDate DATE NOT NULL,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; Amount DECIMAL(10,2) NOT NULL,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; PaymentStatus VARCHAR(30) NOT NULL,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; PaymentMethod VARCHAR(50),&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; CONSTRAINT fk_billing_appointment&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; FOREIGN KEY (AppointmentID)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; REFERENCES Appointment(AppointmentID),&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; CONSTRAINT chk_billing_amount&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; CHECK (Amount &amp;gt;= 0)&lt;/div&gt;&lt;div&gt;);&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="1663.93" width="690" x="4250" y="2277.57" as="geometry" />
        </mxCell>
        <mxCell id="VpzSjvloVnrgPybgbCj5-887" connectable="0" parent="1" style="group;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="" vertex="1">
          <mxGeometry height="441.5" width="1426.8600000000001" x="100" y="3610" as="geometry" />
        </mxCell>
        <mxCell id="VpzSjvloVnrgPybgbCj5-883" parent="VpzSjvloVnrgPybgbCj5-887" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=18;" value="&lt;div style=&quot;color: rgb(0, 0, 0); text-align: start; font-family: &amp;quot;Segoe UI&amp;quot;; font-size: 16px; line-height: 20px;&quot;&gt;&lt;p&gt;Typical analytical questions would be:&lt;/p&gt;&lt;ul&gt;&lt;li&gt;How many appointments occur per month?&lt;/li&gt;&lt;li&gt;Which doctors or specializations handle the most appointments?&lt;/li&gt;&lt;li&gt;How many appointments are completed, scheduled or cancelled?&lt;/li&gt;&lt;li&gt;What is the average billing amount by doctor/specialization?&lt;/li&gt;&lt;li&gt;Which diagnoses occur most frequently?&lt;/li&gt;&lt;li&gt;How does appointment activity vary across patients?&lt;/li&gt;&lt;/ul&gt;&lt;div&gt;&lt;div style=&quot;color: rgb(0, 0, 0); line-height: 20px;&quot;&gt;The key is to preserve &lt;strong&gt;one fact row per appointment&lt;/strong&gt; and prevent both doctors and diagnoses from multiplying appointment measures such as billing amount.&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="325.06" width="551" x="2.210000000000008" y="114.94000000000005" as="geometry" />
        </mxCell>
        <mxCell id="VpzSjvloVnrgPybgbCj5-884" parent="VpzSjvloVnrgPybgbCj5-887" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=16;" value="&lt;div&gt;&lt;span&gt;Conceptually:&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&amp;nbsp;DimDate&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; |&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; |&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;DimPatient ---- FactAppointment ---- DimDoctor&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; |&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; |&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; DimSpecialization&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; |&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; |&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; DimStatus&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="320" width="338.14" x="524.81" y="121.5" as="geometry" />
