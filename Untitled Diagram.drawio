        <mxCell id="MAwl2OnnpyVytO2v4TgS-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;rounded=0;fontSize=200;fontFamily=Times New Roman;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="DigiHealth Project" vertex="1">
          <mxGeometry height="310" width="5430" x="-65" y="-630" as="geometry" />
        </mxCell>
        <mxCell id="MAwl2OnnpyVytO2v4TgS-455" connectable="0" parent="1" style="group;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="" vertex="1">
          <mxGeometry height="1085.5" width="1637.22" x="2871.3900000000003" y="-73" as="geometry" />
        </mxCell>
        <mxCell id="MAwl2OnnpyVytO2v4TgS-198" parent="MAwl2OnnpyVytO2v4TgS-455" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;u&gt;Functional dependency:&lt;/u&gt;&lt;/span&gt;&lt;/h1&gt;&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;div style=&quot;color: rgb(0, 0, 0); font-family: &amp;quot;Segoe UI&amp;quot;; font-size: 14px; line-height: 20px;&quot;&gt;&lt;p style=&quot;font-weight: 400;&quot;&gt;Therefore:&lt;/p&gt;&lt;p style=&quot;font-weight: 400;&quot;&gt;&lt;code&gt;BillingID → AppointmentID → PatientID&lt;/code&gt;&lt;/p&gt;&lt;p style=&quot;&quot;&gt;&lt;u style=&quot;&quot;&gt;That means &lt;code style=&quot;&quot;&gt;PatientID&lt;/code&gt; can be determined &lt;strong style=&quot;&quot;&gt;indirectly&lt;/strong&gt; from &lt;code style=&quot;&quot;&gt;BillingID&lt;/code&gt; through &lt;code style=&quot;&quot;&gt;AppointmentID&lt;/code&gt;.&lt;/u&gt;&lt;/p&gt;&lt;/div&gt;&lt;/h1&gt;" vertex="1">
          <mxGeometry height="230.1059907834101" width="297.67636363636365" x="1214.5096410909089" y="30.013824884792623" as="geometry" />
        </mxCell>
        <mxCell id="MAwl2OnnpyVytO2v4TgS-195" parent="MAwl2OnnpyVytO2v4TgS-455" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=12;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;div style=&quot;&quot;&gt;&lt;u&gt;⚠️ C. Billing&lt;/u&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;We intentionally avoided:&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;Billing.PatientID&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;because the relationship is already obtainable:&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;Billing → Appointment → Patient&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;That decision should be validated under dependency analysis.&lt;/div&gt;" vertex="1">
          <mxGeometry height="240.11059907834098" width="411.7856363636364" x="772.9563683636358" as="geometry" />
        </mxCell>
        <mxCell id="MAwl2OnnpyVytO2v4TgS-196" parent="MAwl2OnnpyVytO2v4TgS-455" style="text;whiteSpace=wrap;html=1;fontSize=10;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;div style=&quot;font-family: &amp;quot;Segoe UI&amp;quot;; font-size: 12px; font-style: normal; font-weight: 400; line-height: 20px;&quot;&gt;&lt;p&gt;And Billing:&amp;nbsp;&lt;/p&gt;&lt;div class=&quot;___5wvz9a0 ftgm304 f1oy3dpc fm6nont f48hbct&quot; role=&quot;group&quot; aria-label=&quot;Table&quot; tabindex=&quot;0&quot; aria-expanded=&quot;false&quot;&gt;&lt;div class=&quot;___1dmoc29 f10pi13n ftgm304 f1enuhaj fdclmfp f1nbblvp fat0sn4 f1ov4xf1 fekwl8i f1lmfglv f1oz7aqm f1abmfm4 f1w619qj f16h0jq8&quot; role=&quot;group&quot; aria-label=&quot;Table content&quot;&gt;&lt;table class=&quot;___nvz3nv0 f1ddd56o f16vktn6 f1ahpp82 f11qra4b f1uinfot fibjyge fvueend f9yszdx f1fu4s3n f3l3pb3 f10ghnd0 f8fmt76 fjvbh62 f1qrqxae f1vw5qpk fc02sbz fxawf59 fymf513 f1aoyrul f1el8yx3 f1pymoxg f1ofu761 f1y24664 f7coize f1794535 f1o0pw0q fbjjl9v fk1v6el f16pyhcb f1ixlhx9 f12zef0i flu5r5u f19haqzy f1owmcxx f1oddm8q f1004tna fcoaxci fh0ee9u f15v23i2 f1dmj53 f1r1gcv9 f14z1veh ffufd3x f1ypplot f1660cg&quot;&gt;&lt;tbody&gt;&lt;tr&gt;&lt;th&gt;BillingID&lt;/th&gt;&lt;th&gt;AppointmentID&lt;/th&gt;&lt;th&gt;PatientID&lt;/th&gt;&lt;th&gt;Amount&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;B501&lt;/td&gt;&lt;td&gt;A101&lt;/td&gt;&lt;td&gt;P001&lt;/td&gt;&lt;td&gt;1200&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;B502&lt;/td&gt;&lt;td&gt;A102&lt;/td&gt;&lt;td&gt;P002&lt;/td&gt;&lt;td&gt;850&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="140.06451612903226" width="307.5989090909091" x="777.4810490909084" y="190.0875576036866" as="geometry" />
        </mxCell>
        <mxCell id="MAwl2OnnpyVytO2v4TgS-197" parent="MAwl2OnnpyVytO2v4TgS-455" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=12;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;div style=&quot;color: rgb(0, 0, 0); text-align: start; font-family: &amp;quot;Segoe UI&amp;quot;; font-size: 10px; line-height: 20px;&quot;&gt;&lt;p&gt;But look carefully at &lt;code&gt;B501&lt;/code&gt;.&amp;nbsp;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); background-color: transparent;&quot;&gt;We know:&amp;nbsp;&lt;/span&gt;&lt;strong style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); background-color: transparent;&quot;&gt;B501 → A101&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;and Appointment &lt;code&gt;A101&lt;/code&gt; already tells us:&amp;nbsp;&lt;strong style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); background-color: transparent;&quot;&gt;A101 → P001&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Therefore:&amp;nbsp;&lt;strong style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); background-color: transparent;&quot;&gt;B501 → A101 → P001&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;We don&#39;t actually need &lt;code&gt;P001&lt;/code&gt; repeated inside Billing.&lt;/p&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="170.07834101382485" width="238.0319429090909" x="777.9176410909084" y="293.1350230414746" as="geometry" />
        </mxCell>
